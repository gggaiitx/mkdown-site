; ============================================================================
; 码克 (mkdown) — NSIS installer hooks
;
; v0.7.7 起 bundle.fileAssociations 只声明 md / mh 两个扩展名。
; 本 hook 在安装完成后清理 0.6.3 ~ 0.7.6 写入 HKCU 的 200+ 扩展名强绑定,
; 使升级后系统关联回到「只有 .md / .mh 指向码克」的状态。
;
; 旧版写入形态 (Tauri NSIS currentUser 模式):
;   HKCU\Software\Classes\.<ext>    默认值 = "<ext>" (裸扩展名, 系统与其它软件不会这样写)
;   HKCU\Software\Classes\<ext>     ProgID, shell\open\command -> mkdown.exe "%1"
;
; 安全判定: 仅当 .<ext> 默认值恰好等于裸扩展名时才视为码克遗留并删除,
;           不会触碰系统默认 (batfile / txtfile / JSFile ...) 或其它软件的关联。
; 执行时机: POSTINSTALL — 新关联写入之后执行, 不会被安装器覆写。
; ============================================================================

!macro MK_CleanAssoc EXT PROGID
  ClearErrors
  ReadRegStr $R0 HKCU "Software\Classes\${EXT}" ""
  StrCmp $R0 "${PROGID}" 0 +3
    DeleteRegKey HKCU "Software\Classes\${EXT}"
    DeleteRegKey HKCU "Software\Classes\${PROGID}"
!macroend

; 危险可执行脚本类型: 同时复位「打开方式」里残留的码克选择 (UserChoice)
!macro MK_CleanUserChoice EXT PROGID
  ClearErrors
  ReadRegStr $R0 HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\${EXT}\UserChoice" "ProgId"
  StrCmp $R0 "${PROGID}" 0 +2
    DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\${EXT}\UserChoice"
!macroend

!macro NSIS_HOOK_POSTINSTALL
  ; --- 1. 可执行脚本类: 清除文件关联 + UserChoice 残留 ---
  !insertmacro MK_CleanUserChoice ".bat" "bat"
  !insertmacro MK_CleanUserChoice ".cmd" "cmd"
  !insertmacro MK_CleanUserChoice ".vbs" "vbs"
  !insertmacro MK_CleanUserChoice ".js" "js"
  !insertmacro MK_CleanUserChoice ".inf" "inf"
  !insertmacro MK_CleanUserChoice ".ps1" "ps1"
  !insertmacro MK_CleanUserChoice ".pwsh" "pwsh"
  !insertmacro MK_CleanUserChoice ".pyw" "pyw"

  ; --- 2. 旧版声明过的全部扩展名 (字符序) ---
  !insertmacro MK_CleanAssoc ".apl" "apl"
  !insertmacro MK_CleanAssoc ".asc" "asc"
  !insertmacro MK_CleanAssoc ".asm" "asm"
  !insertmacro MK_CleanAssoc ".asn" "asn"
